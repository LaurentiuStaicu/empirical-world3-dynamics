{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LaurentiuStaicu/world3-empirical-flatpak/science/configs/real_model_structure.schema.json",
  "title": "R2 Real Model structural schema",
  "type": "object",
  "required": ["schema_version", "model_id", "reference_core", "modules", "candidate_interfaces", "validation_gates"],
  "properties": {
    "schema_version": {"type": "string", "const": "r2.1"},
    "model_id": {"type": "string", "minLength": 1},
    "reference_core": {
      "type": "object",
      "required": ["engine", "source_path", "equation_policy", "baseline_scenarios"],
      "properties": {
        "engine": {"type": "string"},
        "source_path": {"type": "string"},
        "equation_policy": {"type": "string", "const": "preserve_authoritative_equations"},
        "baseline_scenarios": {
          "type": "array",
          "minItems": 3,
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "modules": {
      "type": "array",
      "minItems": 5,
      "items": {"$ref": "#/$defs/module"}
    },
    "candidate_interfaces": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    },
    "validation_gates": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "pattern": "^S(10|[1-9])$"},
          "name": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": {"type": "integer"}
    },
    "quantity": {
      "type": "object",
      "required": ["id", "role", "unit", "dimension", "evidence_role"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"enum": ["stock", "flow", "auxiliary", "exogenous_driver", "observation_bridge", "diagnostic"]},
        "unit": {"type": "string", "minLength": 1},
        "dimension": {"$ref": "#/$defs/dimension"},
        "evidence_role": {"enum": ["observed", "diagnostic", "stress", "candidate_feedback", "central_feedback", "reference"]},
        "changes_stock": {"type": "string"},
        "direction": {"enum": ["in", "out"]},
        "source_binding": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "module": {
      "type": "object",
      "required": ["id", "evidence_role", "boundary", "quantities"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "evidence_role": {"enum": ["observed", "diagnostic", "stress", "candidate_feedback", "central_feedback", "reference"]},
        "boundary": {
          "type": "object",
          "required": ["endogenous", "exogenous", "excluded"],
          "properties": {
            "endogenous": {"type": "array", "items": {"type": "string"}},
            "exogenous": {"type": "array", "items": {"type": "string"}},
            "excluded": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "quantities": {"type": "array", "items": {"$ref": "#/$defs/quantity"}},
        "equation_source": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "candidate": {
      "type": "object",
      "required": ["id", "evidence_role", "active", "central", "status", "inputs", "outputs"],
      "properties": {
        "id": {"type": "string"},
        "evidence_role": {"enum": ["candidate_feedback", "diagnostic", "stress"]},
        "active": {"type": "boolean", "const": false},
        "central": {"type": "boolean", "const": false},
        "status": {"type": "string"},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "forbidden_links": {"type": "array", "items": {"type": "string"}},
        "double_counting_risks": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
